        "description": "Each job may only be assigned to eligible machines."
      }
    ],

    "objective": {
      "id": "min_total_cost_with_changeover",
      "description": "Minimize assignment cost plus changeover penalties when a machine switches jobs between consecutive slots."
    },

    "result_schema_hint": {
      "solver_status": "string",
      "objective_value": "number",
