    "machines": ["M1", "M2"],
    "slots": [0, 1, 2],
    "workers": []
  },
  "parameters": {
    "eligible": {
      "J1": ["M1", "M2"],
      "J2": ["M1"],
      "J3": ["M2"],
      "J4": ["M1", "M2"]
    },
    "cost": {
      "J1|M1|0": 2,
      "J1|M1|1": 2,
      "J1|M1|2": 2,
      "J1|M2|0": 3,
      "J1|M2|1": 3,
      "J1|M2|2": 3,

      "J2|M1|0": 1,
      "J2|M1|1": 5,
      "J2|M1|2": 5,

      "J3|M2|0": 1,
      "J3|M2|1": 5,
      "J3|M2|2": 5,

      "J4|M1|0": 4,
      "J4|M1|1": 1,
      "J4|M1|2": 4,
      "J4|M2|0": 4,
      "J4|M2|1": 1,
      "J4|M2|2": 4
    },

    "changeover_penalty": 3
  },

  "evaluation_framework": {
    "hard_rules": [
      {
        "id": "job_assigned_once",
        "description": "Each job must appear exactly once in assignments."
